---
import type { Dictionary } from '../i18n';
import Icon from './Icon.astro';
import Section from './Section.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const { degree } = t.education;

// Concluídas primeiro; as em andamento vão para o fim da lista.
const certifications = [...t.education.certifications].sort(
  (a, b) => Number(!!a.inProgress) - Number(!!b.inProgress),
);
---

<Section id="education" eyebrow={t.education.eyebrow} title={t.education.title}>
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-17">
    <article data-reveal class="border-t border-line pt-6">
      <h3 class="mb-2 text-xl font-light text-fg md:text-2xl">{degree.course}</h3>
      <p class="text-muted">{degree.institution}</p>
      <p class="mt-2 text-sm text-subtle">{degree.period}</p>
    </article>

    <div data-reveal>
      <h3 class="mb-6 text-sm tracking-(--tracking-label) text-subtle uppercase">
        {t.education.certificationsTitle}
      </h3>
      <ul class="space-y-4">
        {
          certifications.map((c) => (
            <li class="border-t border-line pt-4 first:border-t-0 first:pt-0">
              <p class:list={['text-sm leading-relaxed lg:text-base', c.inProgress ? 'text-muted' : 'text-soft']}>
                {
                  c.href ? (
                    <a
                      href={c.href}
                      target="_blank"
                      rel="noopener"
                      class="group/link inline-flex items-center gap-1.5 underline decoration-line-strong underline-offset-4 transition-colors duration-150 hover:text-fg hover:decoration-fg"
                    >
                      {c.name}
                      <span class="sr-only"> ({t.a11y.opensInNewTab})</span>
                      <Icon
                        name="arrow-up-right"
                        size={14}
                        class="shrink-0 text-subtle transition-transform duration-150 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
                      />
                    </a>
                  ) : (
                    c.name
                  )
                }
              </p>
              <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-subtle">
                <span>
                  {c.issuer}
                  {c.year && <> · {c.year}</>}
                </span>
                {c.inProgress && (
                  <span class="rounded-full border border-line px-2.5 py-0.5 text-xs leading-4 tracking-wider uppercase">
                    {t.education.inProgressLabel}
                  </span>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
