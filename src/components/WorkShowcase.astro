---
import { Image } from 'astro:assets';
import type { Dictionary } from '../i18n';
import product from '../assets/projects/verbi-beauty.png';
interface Props { t: Dictionary }
const { t } = Astro.props;
const en = t.meta.htmlLang === 'en';
const copy = en ? {
  label: 'A closer look', title: 'From product to the details.',
  intro: 'Explore what I build and the engineering decisions behind it.',
  pause: 'Pause motion', resume: 'Resume motion', carousel: 'Selected work',
  note: 'Technical demonstrations use fictional scenarios. Videos are silent, with text in Portuguese.',
  items: [
    { label: '01 / Product', title: 'Verbi Beauty', type: 'Product screenshot', text: 'A management platform for beauty businesses, built with my co-founder. My work spans the backend, frontend, payments and tenant isolation.', proof: 'Java · Spring Boot · React', link: 'Explore the projects', href: '#projects' },
    { label: '02 / Security', title: 'Access has a boundary.', type: 'Technical demonstration · 40s', text: 'An authenticated session is only the beginning. This example shows tenant scope checked during both reads and writes.', proof: '56 selected local tests passed · mocked dependencies', link: 'Discuss application security', href: '#contact' },
    { label: '03 / Payments', title: 'Delivered twice. Confirmed once.', type: 'Technical demonstration · 44s', text: 'Event deduplication, a transactional lock and a paid-state check protect the deposit confirmation flow from repeated notifications.', proof: '70 selected local tests passed · mocked dependencies', link: 'Discuss backend engineering', href: '#contact' }
  ]
} : {
  label: 'Por dentro do trabalho', title: 'Do produto ao detalhe.',
  intro: 'Explore o que construo e as decisões de engenharia por trás.',
  pause: 'Pausar movimento', resume: 'Retomar movimento', carousel: 'Trabalhos em destaque',
  note: 'As demonstrações técnicas usam cenários fictícios. Vídeos sem áudio.',
  items: [
    { label: '01 / Produto', title: 'Verbi Beauty', type: 'Captura do produto', text: 'Uma plataforma de gestão para negócios de beleza, desenvolvida com meu sócio. Atuo no backend, frontend, pagamentos e isolamento entre empresas.', proof: 'Java · Spring Boot · React', link: 'Explorar os projetos', href: '#projects' },
    { label: '02 / Segurança', title: 'Acesso tem limite.', type: 'Demonstração técnica · 40s', text: 'Uma sessão autenticada é só o começo. Neste exemplo, o escopo da empresa é verificado na leitura e também na gravação.', proof: '56 testes locais selecionados passaram · dependências simuladas', link: 'Conversar sobre segurança', href: '#contact' },
    { label: '03 / Pagamentos', title: 'Chegou duas vezes. Confirmou uma.', type: 'Demonstração técnica · 44s', text: 'Deduplicação de eventos, trava na transação e verificação do estado pago protegem a confirmação do sinal contra notificações repetidas.', proof: '70 testes locais selecionados passaram · dependências simuladas', link: 'Conversar sobre backend', href: '#contact' }
  ]
};
const videos = ['', 'authorization', 'webhooks'];
---

<section id="work-in-motion" class="showcase" aria-labelledby="showcase-title">
  <div class="page-container">
    <div class="showcase-heading" data-reveal>
      <div>
        <p class="eyebrow">{copy.label}</p>
        <h2 id="showcase-title" class="font-display">{copy.title}</h2>
      </div>
      <p class="showcase-intro">{copy.intro}</p>
    </div>
    <work-showcase data-pause={copy.pause} data-resume={copy.resume}>
      <div class="showcase-toolbar">
        <div class="case-tabs" role="tablist" aria-label={copy.carousel}>
          {copy.items.map((item, i) => <button id={`case-tab-${i}`} role="tab" aria-controls={`case-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-case={i}>{item.label}</button>)}
        </div>
        <button class="motion-toggle" data-motion aria-pressed="false">{copy.pause}</button>
      </div>
      {copy.items.map((item, i) => (
        <article id={`case-panel-${i}`} role="tabpanel" aria-labelledby={`case-tab-${i}`} tabindex="0" hidden={i !== 0} class="case-panel" data-panel={i}>
          <div class="case-visual">
          <div class:list={['case-media', i === 0 && 'product-media']}>
            {i === 0 ? <Image src={product} alt={t.projects.items[0].imageAlt} width={1000} widths={[500, 750, 1000]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" class="product-image" /> : <video data-video={i} controls muted playsinline preload="none" poster={`/media/${videos[i]}.png`} aria-label={item.type}><source data-src={`/media/${videos[i]}.mp4`} type="video/mp4" />{en ? 'Your browser does not support video.' : 'Seu navegador não oferece suporte a vídeo.'}</video>}
          </div>
            <p class="media-caption">{item.type}</p>
          </div>
          <div class="case-copy">
            <span class="case-number" aria-hidden="true">0{i + 1}</span>
            <h3 class="font-display">{item.title}</h3>
            <p class="case-description">{item.text}</p>
            <p class="case-proof">{item.proof}</p>
            <a href={item.href} class="case-link">{item.link}<span aria-hidden="true"> ↗</span></a>
          </div>
        </article>
      ))}
      <p class="showcase-note">{copy.note}</p>
    </work-showcase>
  </div>
</section>

<style>
  .showcase { padding: 5rem 0 6rem; border-block: 1px solid var(--color-line); background: var(--color-bg-alt); }
  .showcase-heading { display:flex; align-items:end; justify-content:space-between; gap:2rem; margin-bottom:2.5rem; }
  .eyebrow { color:var(--color-subtle); font-size:.75rem; text-transform:uppercase; letter-spacing:.13em; margin-bottom:1rem; }
  h2 { font-size:clamp(2.5rem,5.8vw,5rem); line-height:.95; }
  .showcase-intro { max-width:18rem; color:var(--color-muted); font-size:.9rem; line-height:1.7; }
  work-showcase { display:block; }
  .showcase-toolbar { display:flex; align-items:center; justify-content:space-between; gap:1.5rem; border-bottom:1px solid var(--color-line); }
  .case-tabs { display:flex; gap:1.75rem; }
  .case-tabs button { position:relative; padding:1rem 0; color:var(--color-subtle); font-size:.8rem; cursor:pointer; white-space:nowrap; }
  .case-tabs button[aria-selected="true"] { color:var(--color-fg); }
  .case-tabs button[aria-selected="true"]::after { content:''; position:absolute; height:2px; background:var(--color-fg); bottom:-1px; inset-inline:0; }
  .motion-toggle { color:var(--color-muted); font-size:.7rem; text-decoration:underline; text-underline-offset:4px; cursor:pointer; padding:.75rem 0; }
  .case-panel { display:grid; grid-template-columns:1.15fr 1fr; gap:3rem; align-items:center; padding-top:2rem; animation:case-enter .45s ease-out; }
  .case-panel[hidden] { display:none; }
  .case-media { position:relative; min-width:0; aspect-ratio:1; overflow:hidden; background:#101416; border:1px solid var(--color-line); border-radius:4px; }
  video { width:100%; height:100%; object-fit:contain; display:block; }
  .product-media { display:flex; align-items:center; background:#f4ede3; }
  .product-image { display:block; width:100%; height:auto; object-fit:contain; animation:product-tour 16s ease-in-out infinite alternate; }
  .case-visual { min-width:0; }
  .media-caption { padding-top:.65rem; color:var(--color-subtle); font-size:.65rem; letter-spacing:.04em; }
  .case-copy { min-width:0; }
  .case-number { display:block; color:var(--color-subtle); font-size:.75rem; letter-spacing:.13em; margin-bottom:2rem; }
  h3 { font-size:clamp(2.3rem,4.1vw,4rem); line-height:1; max-width:10ch; text-wrap:balance; }
  .case-description { color:var(--color-muted); font-size:.95rem; line-height:1.8; margin-top:1.5rem; max-width:33rem; }
  .case-proof { margin-top:1.5rem; font-size:.7rem; line-height:1.7; color:var(--color-soft); padding-top:1rem; border-top:1px solid var(--color-line); }
  .case-link { display:inline-flex; align-items:center; justify-content:space-between; gap:2rem; padding-block:1rem; margin-top:1.25rem; border-bottom:1px solid var(--color-line-strong); font-size:.8rem; transition:color .15s; }
  .case-link:hover { color:#a6d5e7; }
  .showcase-note { color:var(--color-subtle); font-size:.65rem; line-height:1.7; margin-top:1.25rem; }
  work-showcase[data-paused] .product-image { animation-play-state:paused; }
  @keyframes case-enter { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
  @keyframes product-tour { from { transform:translateY(0); } to { transform:translateY(-8px); } }
  @media(max-width:899px) { .case-panel { gap:2rem; grid-template-columns:1fr; } .case-media { max-height:32rem; } .case-copy { padding-bottom:.5rem; } h3 { max-width:18ch; } .case-number { margin-bottom:1rem; } .showcase-heading { display:block; } .showcase-intro { margin-top:1rem; max-width:25rem; } }
  @media(max-width:520px) { .showcase { padding-block:3.5rem; } .showcase-toolbar { flex-wrap:wrap; gap:0; padding-bottom:.5rem; } .case-tabs { width:100%; justify-content:space-between; gap:.7rem; } .case-tabs button { font-size:.7rem; } .motion-toggle { padding-top:1rem; } .case-panel { padding-top:1.25rem; gap:1.5rem; } .media-caption { font-size:.55rem; } }
  @media(prefers-reduced-motion:reduce) { .case-panel,.product-image { animation:none; } }
</style>

<script>
  class WorkShowcase extends HTMLElement {
    connectedCallback() {
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[data-case]')];
      const panels = [...this.querySelectorAll<HTMLElement>('[data-panel]')];
      const toggle = this.querySelector<HTMLButtonElement>('[data-motion]')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let active = 0;
      let paused = reduced.matches;
      let visible = false;
      const videos = [...this.querySelectorAll<HTMLVideoElement>('video')];
      const sync = () => {
        this.toggleAttribute('data-paused', paused || !visible || document.hidden);
        toggle.textContent = paused ? this.dataset.resume! : this.dataset.pause!;
        toggle.setAttribute('aria-pressed', String(paused));
        videos.forEach(video => {
          if (Number(video.dataset.video) !== active || paused || !visible || document.hidden) { video.pause(); return; }
          const source = video.querySelector('source')!;
          if (!source.src) { source.src = source.dataset.src!; video.load(); }
          video.muted = true;
          video.play().catch(() => { /* Native controls remain available when autoplay is blocked. */ });
        });
      };
      const select = (index: number, focus = false) => {
        active = index;
        tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
        panels.forEach((panel, i) => { panel.hidden = i !== index; });
        if (focus) tabs[index].focus();
        sync();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', event => {
          let next = i;
          if (event.key === 'ArrowRight') next = (i + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault(); select(next, true);
        });
      });
      toggle.addEventListener('click', () => { paused = !paused; sync(); });
      reduced.addEventListener('change', () => { paused = reduced.matches; sync(); });
      document.addEventListener('visibilitychange', sync);
      const observer = new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); }, { threshold:.15 });
      observer.observe(this);
      sync();
    }
  }
  if (!customElements.get('work-showcase')) customElements.define('work-showcase', WorkShowcase);
</script>
