---
interface Props {
  items: string[];
  label?: string;
  size?: 'sm' | 'md';
}

const { items, label, size = 'sm' } = Astro.props;
---

{
  items.length > 0 && (
    <ul
      class:list={['flex flex-wrap', size === 'md' ? 'gap-3' : 'gap-2']}
      aria-label={label}
    >
      {items.map((item) => (
        <li
          class:list={[
            'rounded-full border border-line bg-chip',
            size === 'md' ? 'px-4 py-2 text-sm text-soft' : 'px-3 py-1 text-xs leading-5 text-muted',
          ]}
        >
          {item}
        </li>
      ))}
    </ul>
  )
}
