---
import type { Dictionary } from '../i18n';
import Section from './Section.astro';
import Tags from './Tags.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

const mainGroups = t.stack.groups.filter((g) => !g.secondary);
const secondaryGroups = t.stack.groups.filter((g) => g.secondary);
---

<Section id="stack" eyebrow={t.stack.eyebrow} title={t.stack.title} alt>
  <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:gap-x-17 lg:gap-y-14">
    {
      mainGroups.map((group) => (
        <div data-reveal>
          <h3 class="mb-6 text-sm tracking-(--tracking-label) text-subtle uppercase">{group.title}</h3>
          <Tags items={group.items} size="md" />
        </div>
      ))
    }
  </div>

  {
    secondaryGroups.map((group) => (
      <div data-reveal class="mt-12 border-t border-line pt-10 lg:mt-14">
        <h3 class="mb-5 text-sm tracking-(--tracking-label) text-subtle uppercase">{group.title}</h3>
        <Tags items={group.items} />
      </div>
    ))
  }
</Section>
