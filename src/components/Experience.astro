---
import type { Dictionary } from '../i18n';
import Section from './Section.astro';
import Tags from './Tags.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<Section id="experience" eyebrow={t.experience.eyebrow} title={t.experience.title} alt>
  <ol
    class="relative space-y-12 before:absolute before:top-2 before:bottom-2 before:left-[7px] before:w-px before:bg-line md:before:left-[10px] lg:space-y-17"
  >
    {
      t.experience.items.map((item) => (
        <li data-reveal class="relative pl-10 md:pl-16">
          <span
            aria-hidden="true"
            class:list={[
              'absolute top-2 left-0 size-[15px] rounded-full border-4 border-bg-alt md:size-[21px]',
              item.current ? 'bg-fg' : 'bg-line-strong',
            ]}
          />
          <article class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-12">
            <div>
              <h3 class="text-xl font-light text-fg md:text-2xl xl:text-3xl">{item.role}</h3>
              <p class="mt-1 text-lg text-muted">{item.company}</p>
              <ul class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-subtle">
                <li>{item.period}</li>
                <li>{item.location}</li>
                {item.current && (
                  <li class="rounded-full border border-fg/30 bg-fg/[0.06] px-2.5 py-0.5 text-xs leading-4 font-medium tracking-wider text-fg uppercase">
                    {t.experience.currentLabel}
                  </li>
                )}
              </ul>
            </div>

            <div>
              <p class="text-sm leading-relaxed text-muted lg:text-base">{item.description}</p>
              {item.highlights.length > 0 && (
                <ul class="dash-list mt-4 space-y-2 text-sm leading-relaxed text-muted lg:text-base">
                  {item.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
              <div class="mt-6">
                <Tags items={item.tags} />
              </div>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</Section>
